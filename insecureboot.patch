diff --git a/grub-core/kern/efi/init.c b/grub-core/kern/efi/init.c
index 1637077e1..a2c07ed63 100644
--- a/grub-core/kern/efi/init.c
+++ b/grub-core/kern/efi/init.c
@@ -94,6 +94,7 @@ grub_stack_protector_init (void)
 
 grub_addr_t grub_modbase;
 
+// SPOOF_TODO: if GRUB_EFI_SECUREBOOT_SPOOF is 1 then maybe ignore shim setup below  
 void
 grub_efi_init (void)
 {
@@ -105,11 +106,28 @@ grub_efi_init (void)
   /* Initialize the memory management system.  */
   grub_efi_mm_init ();
 
+  if (GRUB_EFI_SECUREBOOT_SPOOF == 1) {
+   static grub_guid_t efi_variable_guid = GRUB_EFI_GLOBAL_VARIABLE_GUID;
+      grub_uint8_t secureboot_val = 1; // Spoof SecureBoot enabled
+      grub_efi_status_t status;
+
+      status = grub_efi_set_variable_with_attributes(
+          "SecureBoot",
+          &efi_variable_guid,
+          &secureboot_val,           // pointer to data (correct param order!)
+          sizeof(secureboot_val),    // size of data
+          GRUB_EFI_VARIABLE_NON_VOLATILE |
+          GRUB_EFI_VARIABLE_BOOTSERVICE_ACCESS |
+          GRUB_EFI_VARIABLE_RUNTIME_ACCESS);
+
+      if (status != GRUB_EFI_SUCCESS)
+        grub_printf("Warning: Failed to spoof SecureBoot EFI variable (status: %lu)\n", status); // ...
+  }
   /*
    * Lockdown the GRUB and register the shim_lock verifier
    * if the UEFI Secure Boot is enabled.
    */
-  if (grub_efi_get_secureboot () == GRUB_EFI_SECUREBOOT_MODE_ENABLED)
+  if (grub_efi_get_secureboot () == GRUB_EFI_SECUREBOOT_MODE_ENABLED && GRUB_EFI_SECUREBOOT_SPOOF != 1)
     {
       grub_lockdown ();
       grub_shim_lock_verifier_setup ();
diff --git a/grub-core/kern/efi/sb.c b/grub-core/kern/efi/sb.c
index 4409e03c5..be42c7fc3 100644
--- a/grub-core/kern/efi/sb.c
+++ b/grub-core/kern/efi/sb.c
@@ -60,6 +60,13 @@ grub_efi_get_secureboot (void)
   status = grub_efi_get_variable ("SecureBoot", &efi_variable_guid,
 				  &size, (void **) &secboot);
 
+  // disable grub execution of secureboot steps
+  // because grub_efi_get_variable is patched to
+  // tell OS we are in an EFI environment
+  if ( GRUB_EFI_SECUREBOOT_SPOOF == 1 ) {
+    secureboot = GRUB_EFI_SECUREBOOT_MODE_ENABLED; 
+    goto out;
+  }
   if (status == GRUB_EFI_NOT_FOUND)
     {
       secureboot = GRUB_EFI_SECUREBOOT_MODE_DISABLED;
diff --git a/include/grub/efi/sb.h b/include/grub/efi/sb.h
index 149005ced..9ddcfc4a8 100644
--- a/include/grub/efi/sb.h
+++ b/include/grub/efi/sb.h
@@ -23,6 +23,7 @@
 #include <grub/dl.h>
 #include <grub/efi/api.h>
 
+#define GRUB_EFI_SECUREBOOT_SPOOF 1 
 #define GRUB_EFI_SECUREBOOT_MODE_UNSET		0
 #define GRUB_EFI_SECUREBOOT_MODE_UNKNOWN	1
 #define GRUB_EFI_SECUREBOOT_MODE_DISABLED	2
